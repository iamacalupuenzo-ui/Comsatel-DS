{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/comsatel-ds",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "glob": "**/*.png",
      "input": "src/assets",
      "output": "assets"
    },
    {
      "glob": "styles.css",
      "input": "src/styles",
      "output": "."
    },
    {
      "glob": "tokens.css",
      "input": "src/styles",
      "output": "."
    },
    {
      "glob": "typography-tokens.css",
      "input": "src/styles",
      "output": "."
    }
  ],
  "allowedNonPeerDependencies": ["gsap"]
}
