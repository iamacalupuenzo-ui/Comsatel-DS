/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@iamacalupuenzo-ui/comsatel-ds": ["./dist/comsatel-ds"],
      // Puntos de entrada secundarios: esbuild toma el .mjs (primer destino) y TypeScript los tipos (segundo).
      "@iamacalupuenzo-ui/comsatel-ds/icons": ["./dist/comsatel-ds/fesm2022/iamacalupuenzo-ui-comsatel-ds-icons", "./dist/comsatel-ds/types/iamacalupuenzo-ui-comsatel-ds-icons"],
      "@iamacalupuenzo-ui/comsatel-ds/input": ["./dist/comsatel-ds/fesm2022/iamacalupuenzo-ui-comsatel-ds-input", "./dist/comsatel-ds/types/iamacalupuenzo-ui-comsatel-ds-input"],
      "@iamacalupuenzo-ui/comsatel-ds/motion": ["./dist/comsatel-ds/fesm2022/iamacalupuenzo-ui-comsatel-ds-motion", "./dist/comsatel-ds/types/iamacalupuenzo-ui-comsatel-ds-motion"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./projects/comsatel-ds/tsconfig.lib.json"
    },
    {
      "path": "./projects/comsatel-ds/tsconfig.spec.json"
    }
  ]
}
