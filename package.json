{
  "name": "comsatel-ds-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:lib": "ng build comsatel-ds",
    "build": "npm run build:lib && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test comsatel-ds-angular --watch=false",
    "storybook": "ng run comsatel-ds-angular:storybook",
    "build-storybook": "npm run build:lib && ng run comsatel-ds-angular:build-storybook",
    "docs": "node scripts/props.mjs && node scripts/a11y.mjs",
    "docs:props": "node scripts/props.mjs",
    "docs:a11y": "node scripts/a11y.mjs",
    "check:guidelines": "node scripts/guidelines.mjs",
    "check:props": "node scripts/props.mjs --check",
    "check:a11y": "node scripts/a11y.mjs --check",
    "check:examples": "node scripts/examples.mjs",
    "test:docs": "node --test scripts/checks.test.mjs",
    "check:docs": "npm run check:guidelines && npm run check:props && npm run check:a11y && npm run check:examples && npm run test:docs",
    "gap:report": "node scripts/gap.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@types/leaflet": "^1.9.22",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.7",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@compodoc/compodoc": "^2.0.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/angular": "^10.6.0",
    "@storybook/builder-vite": "^10.6.0",
    "chromatic": "^18.7.2",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
